NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# rate limit API ทั่วไป ต่อ IP (Overview §10.4)
RATE_LIMIT_PER_MINUTE=100
# จำนวน reverse proxy หน้า API ที่เชื่อ X-Forwarded-For (production หลัง Nginx = 1; dev ไม่ต้องตั้ง)
# TRUST_PROXY=0
DATABASE_URL=postgresql://market:market_dev@localhost:5433/market_booking
# integration test (pnpm test:int) — ชื่อ DB ต้องลงท้าย _test; สร้างให้อัตโนมัติ
TEST_DATABASE_URL=postgresql://market:market_dev@localhost:5433/market_booking_test
# connection pool ต่อ API instance (ค่าเริ่มต้น 10) — รวมทุก instance ต้องไม่เกิน max_connections ของ Postgres
# DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
# integration test ใช้ Redis DB แยก (ถูก FLUSHDB ทุกครั้ง) — ไม่ตั้ง = REDIS_URL เปลี่ยนเป็น db 15
# TEST_REDIS_URL=redis://localhost:6379/15
# รัน BullMQ worker (การจองหมดเวลา) ใน API process นี้ — false เมื่อแยก worker ไปอีก process
WORKERS_ENABLED=true
# dev เท่านั้น — production ต้องสุ่มใหม่ (อย่างน้อย 32 ตัวอักษร) เช่น: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# ต้องตรงกับ root user/password ของ minio ใน docker-compose.yml
MINIO_ACCESS_KEY=market_minio
MINIO_SECRET_KEY=market_minio_dev
MINIO_BUCKET=market-booking
MINIO_USE_SSL=false
# URL ที่ browser ใช้อัปโหลด/ดูรูป (presigned URL ผูกกับ host นี้) — dev ไม่ต้องตั้ง
# MINIO_PUBLIC_URL=https://files.example.com
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
LINE_MESSAGING_ACCESS_TOKEN=
SMS_PROVIDER=mock
SMS_API_KEY=
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# ใช้ตอน seed (pnpm db:seed) — production ต้องตั้งรหัสใหม่ ≥ 12 ตัวอักษร
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin1234
# ฝั่ง web (Vite) — LIFF ID ของ LINE Login; ว่าง = ซ่อนปุ่ม LINE
VITE_LINE_LIFF_ID=
