# ค่า production ของ docker/docker-compose.prod.yml — copy เป็น docker/.env แล้วแก้ทุกค่า (ไฟล์ .env ไม่ถูก commit)
#   cp docker/.env.example docker/.env && chmod 600 docker/.env
# สุ่ม secret: openssl rand -hex 32   (ใช้ hex — ปลอดภัยใน URL ของ DATABASE_URL)

# โดเมน (DNS A record ชี้มาที่ VPS ทั้งสองชื่อ)
WEB_DOMAIN=market.example.com
ADMIN_DOMAIN=admin.market.example.com
# อีเมลแจ้งเตือน cert ใกล้หมดอายุจาก Let's Encrypt
LETSENCRYPT_EMAIL=ops@example.com

# PostgreSQL
POSTGRES_USER=market
POSTGRES_PASSWORD=
POSTGRES_DB=market_booking

# JWT — คนละค่ากัน อย่างน้อย 32 ตัวอักษร (เปลี่ยน = ทุกคนต้อง login ใหม่)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MinIO (root user ของ MinIO และ key ที่ API ใช้)
MINIO_ACCESS_KEY=market_minio
MINIO_SECRET_KEY=
MINIO_BUCKET=market-booking

# SUPER_ADMIN คนแรก (ใช้ตอน seed ครั้งเดียว — ≥ 12 ตัวอักษร; ลบออกจากไฟล์ได้หลัง seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# LINE Login (LIFF) — ว่าง = ซ่อนปุ่ม LINE; LINE_LIFF_ID ฝังลงหน้าเว็บตอน build (เปลี่ยนแล้ว deploy ใหม่)
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
LINE_MESSAGING_ACCESS_TOKEN=

# SMS OTP — ยังมีแค่ mock (Phase 7); production ที่เป็น mock จะส่ง OTP ไม่ได้ ผู้ค้าต้องเข้าด้วย LINE
SMS_PROVIDER=mock
SMS_API_KEY=

# Backup (UTC — 20:00 = 03:00 เวลาไทย)
BACKUP_TIME=20:00
BACKUP_KEEP_DAYS=14
# URL "Push" ของ Uptime Kuma — แจ้งทุกครั้งที่ backup สำเร็จ (ว่าง = ไม่แจ้ง)
BACKUP_PUSH_URL=

# อื่นๆ
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=100
DATABASE_POOL_SIZE=10

# IMAGE_TAG=<git commit> ถูกเพิ่ม/แก้โดย docker/scripts/deploy.sh และ rollback.sh — ไม่ต้องตั้งเอง
