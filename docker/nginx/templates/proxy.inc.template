# /api และ /socket.io → api (ใช้ทั้งโดเมนเว็บและ admin — frontend เรียก path สัมพัทธ์ same-origin)
# ไม่ลงท้าย .conf จึงไม่ถูก include อัตโนมัติที่ระดับ http

# metrics / รับ alert ใช้จากใน docker network เท่านั้น (Prometheus/Alertmanager ต่อ api:3000 ตรง)
location = /api/v1/metrics {
  return 404;
}
location /api/v1/internal/ {
  return 404;
}

location /api/ {
  proxy_pass http://api;
  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  # API ตั้ง TRUST_PROXY=1 → req.ip = address ท้ายสุดที่ Nginx ต่อท้าย (ค่าที่ client ปลอมมาข้างหน้าไม่ถูกใช้)
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # export รายงาน (Excel) ใช้เวลาได้
  proxy_read_timeout 120s;
}

location /socket.io/ {
  proxy_pass http://api;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  # socket ค้างยาว — ping ของ Socket.IO (25 s) ทำให้ไม่ idle
  proxy_read_timeout 1h;
  proxy_send_timeout 1h;
}
