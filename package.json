{
  "name": "market-booking",
  "private": true,
  "description": "ระบบจองล็อคขายของตลาด (Monorepo)",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @market-booking/shared build",
    "codegen": "pnpm build:shared && pnpm --filter @market-booking/api db:generate",
    "dev": "pnpm codegen && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm codegen && pnpm -r typecheck",
    "test": "pnpm codegen && pnpm -r test",
    "test:int": "pnpm codegen && pnpm --filter @market-booking/api test:int",
    "prisma": "pnpm --filter @market-booking/api exec prisma",
    "db:migrate": "pnpm --filter @market-booking/api db:migrate",
    "db:deploy": "pnpm --filter @market-booking/api db:deploy",
    "db:seed": "pnpm codegen && pnpm --filter @market-booking/api db:seed",
    "db:reset": "pnpm prisma migrate reset --force && pnpm db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  }
}
